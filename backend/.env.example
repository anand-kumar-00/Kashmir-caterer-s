PORT=3001
NODE_ENV=development

# Database (SQLite file path, relative to /backend)
DB_PATH=../database/kashmir_caterers.db

# Session secret — change this to a long random string in production
SESSION_SECRET=change-me-to-a-long-random-secret-in-production

# SMTP settings for booking confirmation emails (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Google Maps API key (replace APT-KEY with your real key)
MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# Site URL (used in emails and SEO canonical tags)
SITE_URL=http://localhost:3001

# Groq AI — get your key at https://console.groq.com
# NEVER commit the actual key — keep it only in your local .env file
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile
